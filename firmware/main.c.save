#include <stdint.h>

/*
 * RISC-V Firmware
 *
 * This firmware describes the computation that we want
 * our RISC-V processor to execute.
 *
 * The current RTL CPU supports:
 * ADD, SUB, AND, OR, XOR
 * ADDI, ANDI, ORI, XORI
 * LW, SW
 * BEQ, JAL
 */

volatile uint32_t result_add;
volatile uint32_t result_sub;
volatile uint32_t result_and;
volatile uint32_t result_or;
volatile uint32_t result_xor;

int main(void)
{
    uint32_t a = 10;
    uint32_t b = 20;

    result_add = a + b;
    result_sub = b - a;
    result_and = a & b;
    result_or  = a | b;
    result_xor = a ^ b;

    return 0;
}